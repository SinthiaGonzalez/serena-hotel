# Copiar como .env junto a compose.yml y rellenar. Nunca subir el .env a git.
# Una línea por variable, sin comillas y sin comentarios al final de la línea.

# Base de datos (contraseña larga y solo con letras y números)
DB_USER=serena
DB_PASSWORD=
DB_NAME=serena_hotel

# Firma de los JWT: una cadena larga y aleatoria, distinta de la de desarrollo
ACCES_JWT=

# URL pública del front (sin barra al final)
FRONT_URL=https://serena.sinthiagonzalez.com

# Login con Google (el mismo Client ID va al back y al front)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Cloudinary (subida de imágenes desde el panel)
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# Mails (contraseña de aplicación de Google)
GMAIL_USER=
GMAIL_PASSWORD=
CONTACT_EMAIL=

# Stripe en modo test (sk_test_...) y el secreto del webhook de producción
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
